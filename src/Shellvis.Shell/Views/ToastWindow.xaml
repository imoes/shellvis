<Window
    x:Class="Shellvis.Shell.Views.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Shellvis notification">

    <!--
        Outlook's desktop alert, in this application's clothes.

        The shape is copied on purpose rather than invented: a small panel, an accent stripe,
        a source line, one bold sentence, a close cross, and nothing else. Everyone who uses
        Outlook already knows what this is and what clicking it does, and a notification is
        the worst possible place to teach somebody a new convention. It is on screen for
        seven seconds and is read while doing something else.
    -->
    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="Surface"
                Background="{ThemeResource ToastTintBrush}"
                BorderBrush="{ThemeResource ToastBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">

            <Grid Padding="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    The accent stripe carries the identity. A notification arriving at the
                    corner of the screen is recognised before it is read, and a coloured edge
                    is what does that recognising; an icon at this size is a smudge.
                -->
                <Border Grid.Column="0"
                        Width="4"
                        CornerRadius="8,0,0,8"
                        Background="{ThemeResource PillAccentBrush}" />

                <StackPanel Grid.Column="1" Margin="12,10,6,10" Spacing="2">
                    <TextBlock x:Name="Source"
                               Text="Shellvis"
                               FontSize="11"
                               Opacity="0.7"
                               Foreground="{ThemeResource ToastTextBrush}" />

                    <!--
                        Two lines and then an ellipsis. A notification is a pointer to
                        something, not the thing: what does not fit is exactly why the
                        window it opens exists.
                    -->
                    <TextBlock x:Name="Headline"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource ToastTextBrush}" />

                    <TextBlock x:Name="Hint"
                               Text="Click to read"
                               FontSize="11"
                               Opacity="0.6"
                               Foreground="{ThemeResource ToastTextBrush}" />
                </StackPanel>

                <!--
                    Dismiss, and it is a real button rather than "click anywhere to close":
                    the body opens the message window, so the two actions must not share a
                    target. Outlook makes the same split.
                -->
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Width="28" Height="28"
                        Margin="0,6,6,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Dismiss">
                    <TextBlock Text="&#xE711;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="11"
                               Foreground="{ThemeResource ToastTextBrush}" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
