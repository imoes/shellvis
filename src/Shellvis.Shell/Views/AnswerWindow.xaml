<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Shellvis.Shell.Views.AnswerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Shellvis answer">

    <!-- The answer, on a surface of its own.
         The console below the pill is a log: tool calls, warnings, approvals, in the order
         they happened. This is a document: what the assistant said, laid out to be read.
         They were one list until now, and mixing them served neither. -->
    <Grid x:Name="RootHost" Background="Transparent">
        <Border x:Name="Surface"
                CornerRadius="12"
                BorderThickness="1"
                Background="{ThemeResource ConsoleTintBrush}"
                BorderBrush="{ThemeResource SeparatorBrush}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The header doubles as the drag handle: the window has no title bar,
                     so without it there is nothing to grab. -->
                <Grid x:Name="Header" Grid.Row="0" Padding="12,8,8,6" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="HeaderText"
                               Grid.Column="0"
                               Text="Answer"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource ConsoleMutedBrush}" />

                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Style="{StaticResource PillIconButtonSmallStyle}"
                            Content="&#xE711;"
                            ToolTipService.ToolTip="Close (the answer stays in the console)" />
                </Grid>

                <ScrollViewer x:Name="Scroller"
                              Grid.Row="1"
                              Padding="14,0,14,14"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <RichTextBlock x:Name="Body"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
