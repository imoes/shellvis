<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Raised from net10.0-windows to match Core, which is referenced for the speech-model
      download. A lower target cannot reference a higher one, and the alternative is
      duplicating the model catalogue and its URLs into a second place: two places to get a
      1.5 GB download wrong. The runtime requirement does not change; this is a compile-time
      SDK version, and the Shell has always targeted it.
    -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <AssemblyName>Shellvis.Setup</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the contracts: the installer needs the service and pipe NAMES so that a
         rename cannot leave it registering a service the shell never looks for. It
         deliberately does not reference Core, which would drag PowerShell, Office and
         the browser stack into an installer. -->
    <ProjectReference Include="..\Shellvis.Contracts\Shellvis.Contracts.csproj" />

    <!--
      Core, for WhisperModelStore alone. It costs nothing in the package: the four
      executables publish into one folder and the Shell already brings Core.dll, so this
      links against a file that is there either way.
    -->
    <ProjectReference Include="..\Shellvis.Core\Shellvis.Core.csproj" />
  </ItemGroup>

</Project>
