<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Shellvis.Shell.Views.VorzimmerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Shellvis">
    <Grid x:Name="RootHost" Background="{ThemeResource ConsoleTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="14,10,14,8" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="TodayButton" Content="Heute" />
                <Button x:Name="ConversationButton" Content="Unterhaltung" />
                <Button x:Name="DocumentsButton" Content="Dokumente" />
                <Button x:Name="ActivityButton" Content="Aktivität" />
                <Button x:Name="WorkbenchHistoryButton" Content="Verlauf" />
            </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="StateText" Grid.Column="1" VerticalAlignment="Center"
                       FontSize="12" Foreground="{ThemeResource ConsoleMutedBrush}" />
        </Grid>
        <Grid Grid.Row="1" MinHeight="240">
            <WebView2 x:Name="View" />
            <Grid x:Name="ConversationPanel" Visibility="Collapsed" Padding="16,8,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="ConversationScroller" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <RichTextBlock x:Name="ConversationBody" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </ScrollViewer>
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="MeetingAction" Content="Besprechung vorbereiten" />
                    <Button x:Name="MailAction" Content="E-Mail-Antwort entwerfen" />
                    <Button x:Name="DocumentAction" Content="Dokument zusammenfassen" />
                    <Button x:Name="TaskAction" Content="Aufgaben aus Notizen" />
                </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="DocumentsPanel" Visibility="Collapsed" Padding="18,12,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RefreshDocumentsButton" Content="Offene Office-Dokumente aktualisieren" />
                    <Button x:Name="PickDocumentButton" Content="Datei auswählen…" />
                </StackPanel>
                <TextBlock x:Name="DocumentsHint" Grid.Row="1" Margin="0,10,0,10"
                           TextWrapping="Wrap" Foreground="{ThemeResource ConsoleMutedBrush}" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DocumentItems" Spacing="6" />
                </ScrollViewer>
            </Grid>
            <ScrollViewer x:Name="ActivityPanel" Visibility="Collapsed" Padding="18,12"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ActivityItems" Spacing="8" />
            </ScrollViewer>
            <Grid x:Name="WorkbenchHistoryPanel" Visibility="Collapsed" Padding="18,12,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button x:Name="WorkbenchNewSessionButton" Content="Neue Unterhaltung beginnen"
                        HorizontalAlignment="Left" Margin="0,0,0,10" />
                <TextBox x:Name="WorkbenchHistorySearch" Grid.Row="1" Margin="0,0,0,10"
                         PlaceholderText="Unterhaltungen suchen" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="WorkbenchHistoryItems" Spacing="6" />
                </ScrollViewer>
            </Grid>
            <StackPanel x:Name="Missing" Visibility="Collapsed" Padding="24" Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock Text="This page needs the WebView2 runtime" FontSize="15"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="MissingDetail" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource ConsoleMutedBrush}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="0,1,0,0">
        <StackPanel Padding="14,8,14,12" Spacing="6">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ContextButton" Visibility="Collapsed" />
                <TextBlock x:Name="ContextNote" Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource ConsoleMutedBrush}" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WorkbenchPrompt" PlaceholderText="Shellvis fragen"
                         AcceptsReturn="False" VerticalAlignment="Center" />
                <Button x:Name="SendButton" Grid.Column="1" Content="Fragen" />
            </Grid>
        </StackPanel>
        </Border>
    </Grid>
</Window>
