<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Shellvis.Shell.Views.AnswerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Shellvis answer">

    <!-- The answer, on a surface of its own.
         The console below the pill is a log: tool calls, warnings, approvals, in the order
         they happened. This is a document: what the assistant said, laid out to be read.
         They were one list until now, and mixing them served neither. -->
    <Grid x:Name="RootHost" Background="Transparent">
        <Border x:Name="Surface"
                CornerRadius="8"
                BorderThickness="1"
                Background="{ThemeResource ConsoleTintBrush}"
                BorderBrush="{ThemeResource SeparatorBrush}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The header doubles as the drag handle: the window has no title bar,
                     so without it there is nothing to grab. -->
                <Grid x:Name="Header" Grid.Row="0" Padding="12,8,8,6" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="HeaderText"
                               Grid.Column="0"
                               Text="Answer"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource ConsoleMutedBrush}" />

                    <!-- Minimise before close, in the Windows order, and the destructive
                         one furthest from where the pointer usually is. -->
                    <Button x:Name="MinimiseButton"
                            Grid.Column="1"
                            Style="{StaticResource PillIconButtonSmallStyle}"
                            Content="&#xE921;"
                            ToolTipService.ToolTip="Minimise to the taskbar" />

                    <Button x:Name="CloseButton"
                            Grid.Column="2"
                            Style="{StaticResource PillIconButtonSmallStyle}"
                            Content="&#xE711;"
                            ToolTipService.ToolTip="Close (the answer button on the pill brings it back)" />
                </Grid>

                <!-- HorizontalScrollMode="Disabled" is the load-bearing attribute, and its
                     absence was a real defect.

                     HorizontalScrollBarVisibility only hides the BAR. With the scroll mode
                     still enabled, a ScrollViewer measures its content with infinite width,
                     so the RichTextBlock sized itself to its longest line instead of to the
                     viewport: text wrapped at some width of its own choosing and the right
                     third of the window stayed empty. Worse, the renderer asks the same
                     control for ActualWidth to decide how wide a table may be, so the table
                     was clamped to that wrong number too. -->
                <ScrollViewer x:Name="Scroller"
                              Grid.Row="1"
                              Padding="14,0,14,14"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled">

                    <RichTextBlock x:Name="Body"
                                   HorizontalAlignment="Stretch"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
